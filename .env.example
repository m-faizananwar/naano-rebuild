# Copy to .env.local for local dev. Real values never go in the repo.
# On Vercel: Project → Settings → Environment Variables (all environments).

# Postgres connection for drizzle. Supabase dashboard → Connect (top bar) →
# ORMs / Connection string → "Transaction pooler" (port 6543). Replace
# [YOUR-PASSWORD] with the database password from Project Settings → Database.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase dashboard → Project Settings → Data API → "Project URL".
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase dashboard → Project Settings → API Keys. Either the legacy "anon"
# key or the newer "publishable" key (sb_publishable_…) works. Public by design.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase dashboard → Project Settings → API Keys. Either the legacy
# "service_role" key or the newer "secret" key (sb_secret_…). Bypasses RLS —
# server only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Set automatically by Vercel; used by /api/health to report the deployed commit.
# VERCEL_GIT_COMMIT_SHA=
