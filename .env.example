# Copy to .env.local for local dev. Real values never go in the repo.
# On Vercel: Project → Settings → Environment Variables (all environments).

# Postgres for drizzle. Locally: `pnpm db:up` starts docker-compose's postgres 16
# and this URL points at it. On Vercel: the provisioned Postgres connection
# string (transaction pooler if it's Supabase; `prepare: false` is already set).
# If unset, the app renders an honest "database not configured" state and
# /api/health reports it — pages never 500 because of it.
# Vercel's Neon integration writes the variables with a project prefix
# (naano_clone_DATABASE_URL, naano_clone_POSTGRES_URL, …); the app accepts
# DATABASE_URL, naano_clone_DATABASE_URL, POSTGRES_URL, naano_clone_POSTGRES_URL
# in that order and /api/health says which name it used (dbEnv).
# For remote migrate/seed, put DATABASE_URL in a gitignored .env.remote.local
# and run pnpm db:migrate:remote / pnpm db:seed:remote.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/naano

# Anthropic API key for the AI brief generator and Nao matching rationales.
# Optional: without it both fall back to templates and the UI says so.
# console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Voice (optional). With both keys the mic on the floating pill starts a Vapi
# call (their transcription + voice; our /api/voice/vapi webhook runs the
# actions). Without them it uses the browser's Web Speech API (Chrome/Safari)
# and /api/voice/intent directly. Intent parsing uses ANTHROPIC_API_KEY when
# set, otherwise a regex grammar (src/lib/voice-grammar.ts). dashboard.vapi.ai → API keys.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=

# Set automatically by Vercel; used by /api/health to report the deployed commit.
# VERCEL_GIT_COMMIT_SHA=
